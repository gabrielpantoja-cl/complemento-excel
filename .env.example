# MiniMax (Token Plan Plus) Subscription Key.
#
# Copy this file to `.env` and paste your real Subscription Key, e.g.:
#   cp .env.example .env
#   $EDITOR .env   # paste the eyJ... value into MINIMAX_API_KEY
#
# The add-in does not auto-consume this env var at runtime. Office.js webview
# cannot read .env (Vite shims process.env to "{}" for the browser bundle),
# so the Subscription Key still needs to be pasted manually into the Tasaciones
# panel (row "MiniMax (Token Plan Plus)" -> Save) where it is stored in
# IndexedDB under `pi-preset:minimax`.
#
# Source: https://platform.minimaxi.com/user-center/payment/token-plan
MINIMAX_API_KEY=
